# 运行 uv run python scripts/setup.py 创建私有 .env 并生成随机数据库密码。
FS_DATABASE_URL=postgresql+psycopg://frontiersignal:CHANGE_ME@127.0.0.1:54329/frontiersignal
POSTGRES_PASSWORD=CHANGE_ME
FS_SCHEDULER_ENABLED=true
FS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# 新增订阅域名需在这里明确允许，仅接受解析到公网的 HTTPS 来源。
FS_EXTRA_FEED_HOSTS=[]
# 未设置 FS_OUTBOUND_PROXY 时继承 HTTPS_PROXY；设置为空表示直连。
# 模型接口地址、密钥、请求模型标识。可用 scripts/configure_opencode.py 导入指定网关。
FS_LLM_BASE_URL=
FS_LLM_API_KEY=
FS_LLM_MODEL=
FS_LLM_TIMEOUT=60
FS_LLM_MAX_RETRIES=2
FS_LLM_BATCH_SIZE=5
FS_LLM_JSON_MODE=false
# 可选的同一服务商向量模型；留空则关闭，文本模型不一定支持向量接口。
FS_EMBEDDING_MODEL=
FS_SEMANTIC_THRESHOLD=0.94
# 可选的关键词预筛选；未匹配的原始资讯仍保留，并标记为规则过滤。
FS_PREFILTER_KEYWORDS=[]
FS_GITHUB_TOKEN=
# GitHub 官方 API 搜索与持续跟踪预算；公共接口可无令牌使用，额度较低。
FS_GITHUB_QUERIES_PER_RUN=2
FS_GITHUB_CANDIDATES_PER_QUERY=10
FS_GITHUB_TRACK_PER_RUN=10
FS_GITHUB_CODE_CHECKS=3
# 每轮最多两份公开 README；按 push/已有摘要缓存，不执行项目代码。
FS_GITHUB_README_CHECKS=2
# 获取官方逐日获星记录，用于首次发现时的增长判断，独立于本地 Stars 净增快照。
FS_GITHUB_HISTORY_CHECKS=8
FS_HN_CANDIDATES=60
FS_HN_COMMENT_LIMIT=3
# HF 每12个查询名额轮换全站1/主题5/常规组织2/重点账号4；每轮默认6次，每小时采集。
# 不下载权重；相同提交的模型卡复用历史正文。
FS_HF_QUERIES_PER_RUN=6
FS_HF_CANDIDATES_PER_QUERY=5
FS_HF_CARD_CHECKS=6
# 研究偏好只影响推荐；来源采集范围在「信息来源」中独立保存。
FS_INTEREST_TOPICS=["llm","agents","inference","training","rag","multimodal","evaluation","frameworks"]
